{
  "name": "flying-dragon-game",
  "version": "1.0.0",
  "description": "a game in which a flying dragon must collect gems and can shoot fire at enemies",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.ts",
    "test:deploy": "python3 -m unittest discover -s tests -p '*_test.py'",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "start:dev": "npm run dev",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json"
  },
  "keywords": [
    "flying",
    "dragon",
    "game"
  ],
  "author": "elhini",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
